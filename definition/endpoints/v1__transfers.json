{
  "$schema": "https://schemas.analitiq.ai/api-endpoint/latest.json",
  "endpoint_id": "v1__transfers",
  "display_name": "Transfers List",
  "description": "Returns an array of transfer objects for a given profile",
  "operations": {
    "read": {
      "request": {
        "path": "/v1/transfers",
        "method": "GET",
        "query": {
          "profile": { "from_param": "profile" },
          "status": { "from_param": "status" },
          "sourceCurrency": { "from_param": "sourceCurrency" },
          "targetCurrency": { "from_param": "targetCurrency" },
          "createdDateStart": { "from_param": "createdDateStart" },
          "createdDateEnd": { "from_param": "createdDateEnd" },
          "limit": { "from_param": "limit" },
          "offset": { "from_param": "offset" }
        }
      },
      "response": {
        "records": {
          "ref": "response.body"
        },
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "title": "Transfers List",
          "description": "Returns an array of transfer objects for a given profile",
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "user",
              "targetAccount",
              "status",
              "rate",
              "created",
              "sourceCurrency",
              "sourceValue",
              "targetCurrency",
              "targetValue"
            ],
            "properties": {
              "id": {
                "type": "integer",
                "description": "Transfer ID"
              },
              "user": {
                "type": "integer",
                "description": "Your user ID"
              },
              "targetAccount": {
                "type": "integer",
                "description": "Recipient account ID"
              },
              "sourceAccount": {
                "type": "integer",
                "nullable": true,
                "description": "Source borderless account ID"
              },
              "quote": {
                "type": "integer",
                "nullable": true,
                "description": "Quote ID (deprecated, use quoteUuid)"
              },
              "quoteUuid": {
                "type": "string",
                "nullable": true,
                "description": "Quote UUID"
              },
              "status": {
                "type": "string",
                "description": "Transfer current status",
                "enum": [
                  "incoming_payment_waiting",
                  "incoming_payment_initiated",
                  "processing",
                  "funds_converted",
                  "outgoing_payment_sent",
                  "cancelled",
                  "funds_refunded",
                  "bounced_back",
                  "charged_back",
                  "unknown"
                ]
              },
              "reference": {
                "type": "string",
                "nullable": true,
                "description": "Recipient will see this reference text"
              },
              "rate": {
                "type": "number",
                "description": "Exchange rate value"
              },
              "created": {
                "type": "string",
                "format": "date-time",
                "description": "Timestamp when the transfer was created"
              },
              "business": {
                "type": "integer",
                "nullable": true,
                "description": "Business profile ID"
              },
              "transferRequest": {
                "type": "integer",
                "nullable": true,
                "description": "Transfer request ID"
              },
              "details": {
                "type": "object",
                "description": "Transfer details",
                "properties": {
                  "reference": {
                    "type": "string",
                    "nullable": true,
                    "description": "Payment reference text"
                  }
                }
              },
              "hasActiveIssues": {
                "type": "boolean",
                "description": "Whether there are pending issues"
              },
              "sourceCurrency": {
                "type": "string",
                "description": "Source currency code"
              },
              "sourceValue": {
                "type": "number",
                "description": "Amount in source currency"
              },
              "targetCurrency": {
                "type": "string",
                "description": "Target currency code"
              },
              "targetValue": {
                "type": "number",
                "description": "Amount in target currency"
              },
              "customerTransactionId": {
                "type": "string",
                "nullable": true,
                "description": "Unique ID assigned by customer for deduplication"
              }
            }
          }
        }
      },
      "params": {
        "profile": {
          "in": "query",
          "type": "integer",
          "required": true,
          "default": {
            "ref": "connection.selections.profile_id"
          },
          "description": "Wise profile id selected post-auth."
        },
        "status": {
          "in": "query",
          "type": "string",
          "required": false,
          "description": "Comma-separated list of transfer status codes",
          "operators": [
            "eq",
            "in"
          ]
        },
        "sourceCurrency": {
          "in": "query",
          "type": "string",
          "required": false,
          "description": "Source currency code",
          "operators": [
            "eq"
          ]
        },
        "targetCurrency": {
          "in": "query",
          "type": "string",
          "required": false,
          "description": "Target currency code",
          "operators": [
            "eq"
          ]
        },
        "createdDateStart": {
          "in": "query",
          "type": "string",
          "required": false,
          "controlled_by": "replication",
          "description": "Starting date to filter transfers, inclusive"
        },
        "createdDateEnd": {
          "in": "query",
          "type": "string",
          "required": false,
          "description": "Ending date to filter transfers, inclusive",
          "operators": [
            "lte"
          ]
        },
        "limit": {
          "in": "query",
          "type": "integer",
          "required": false,
          "controlled_by": "pagination",
          "description": "Page size."
        },
        "offset": {
          "in": "query",
          "type": "integer",
          "required": false,
          "controlled_by": "pagination",
          "description": "Offset/start index."
        }
      },
      "pagination": {
        "type": "offset",
        "offset": {
          "param": "offset",
          "initial": 0,
          "increment_by": {
            "ref": "response.record_count"
          }
        },
        "limit": {
          "param": "limit",
          "max": 100,
          "default": {
            "ref": "runtime.batch_size"
          }
        },
        "stop_when": {
          "empty": {
            "ref": "response.body"
          }
        }
      },
      "replication": {
        "supported_methods": [
          "full_refresh",
          "incremental"
        ],
        "cursor_mappings": [
          {
            "cursor_field": "created",
            "param": "createdDateStart",
            "operator": "gte",
            "format": "date-time"
          }
        ]
      }
    }
  }
}
