{
  "$schema": "https://schemas.analitiq.ai/connector/latest.json",
  "kind": "api",
  "connector_id": "wise-api-key",
  "display_name": "Wise (API Key)",
  "description": "International money transfer and multi-currency account platform (formerly TransferWise)",
  "documentation_url": "https://docs.wise.com/api-docs/api-reference",
  "version": "0.2.4",
  "default_transport": "api",
  "transports": {
    "api": {
      "transport_type": "http",
      "base_url": "https://api.wise.com",
      "headers": {
        "Accept": "application/json",
        "Content-Type": "application/json",
        "Authorization": {
          "template": "Bearer ${secrets.api_key}"
        }
      },
      "timeout_seconds": 30,
      "rate_limit": {
        "max_requests": 1000,
        "time_window_seconds": 60
      }
    }
  },
  "auth": {
    "type": "api_key"
  },
  "connection_contract": {
    "inputs": {
      "api_key": {
        "source": "user",
        "phase": "pre_auth",
        "storage": "secrets",
        "type": "string",
        "required": true,
        "secret": true,
        "ui": {
          "label": "Personal API Token",
          "widget": "password",
          "help_text": "Generate from Wise.com > Your Account > Integrations and Tools > API tokens"
        }
      }
    },
    "post_auth_outputs": {
      "profile_id": {
        "mode": "user_selection",
        "storage": "connection.selections",
        "type": "integer",
        "value_path": "id",
        "label_path": "fullName",
        "options_request": {
          "transport_ref": "api",
          "method": "GET",
          "path": "/v2/profiles"
        },
        "ui": {
          "label": "Select Profile"
        }
      }
    },
    "required_for_activation": [
      "connection.selections.profile_id"
    ]
  }
}
